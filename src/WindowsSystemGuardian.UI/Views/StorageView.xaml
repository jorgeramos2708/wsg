<UserControl x:Class="WindowsSystemGuardian.UI.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,34">
            <TextBlock Text="Almacenamiento" Style="{StaticResource WsgSectionTitleStyle}" />
            <TextBlock Text="Detalle de todos los volúmenes detectados. Recovery, EFI y volúmenes no determinados se muestran, pero no penalizan la salud global sin evidencia suficiente." Style="{StaticResource WsgMutedTextStyle}" Margin="0,4,0,20" TextWrapping="Wrap" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource WsgCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SALUD DE ALMACENAMIENTO" Style="{StaticResource WsgMutedTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding System.StorageScoreText, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" Foreground="#FF111827" />
                            <TextBlock Text="/100" Foreground="{StaticResource WsgMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,5" />
                        </StackPanel>
                        <TextBlock Text="{Binding System.StorageHealth, Mode=OneWay}" Foreground="{StaticResource WsgBlueBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource WsgCardStyle}">
                    <StackPanel>
                        <TextBlock Text="VOLÚMENES DETECTADOS" Style="{StaticResource WsgMutedTextStyle}" />
                        <TextBlock Text="{Binding System.VolumeCount, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" Foreground="#FF111827" Margin="0,6,0,0" />
                        <TextBlock Text="Sistema, datos y volúmenes informativos" Style="{StaticResource WsgMutedTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding System.Volumes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WsgCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#FF111827" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Type, Mode=OneWay}" Style="{StaticResource WsgMutedTextStyle}" />
                                        <TextBlock Text=" · " Style="{StaticResource WsgMutedTextStyle}" />
                                        <TextBlock Text="{Binding FileSystem, Mode=OneWay}" Style="{StaticResource WsgMutedTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Purpose, Mode=OneWay}" Foreground="{StaticResource WsgBlueBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding MountPathText, Mode=OneWay}" Style="{StaticResource WsgMutedTextStyle}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,4" VerticalAlignment="Center">
                                    <Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentUsed, Mode=OneWay}" Height="9" />
                                        <TextBlock Text="{Binding PercentUsedText, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-23,0,0" Foreground="#FF374151" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock Text="{Binding UsedText, Mode=OneWay}" Foreground="#FF374151" Margin="0,7,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding FreeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF111827" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding HealthDisplay, Mode=OneWay}" Foreground="{StaticResource WsgBlueBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding SystemBadge, Mode=OneWay}" Foreground="{StaticResource WsgMutedBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
