<Window x:Class="WindowsSystemGuardian.UI.Views.RemediationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remediación controlada"
        Width="860" Height="720"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">

            <TextBlock Text="Remediación controlada" FontSize="22" FontWeight="SemiBold" Foreground="#FF172033" />
            <TextBlock Text="{Binding IncidentTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RootCauseTitle, Mode=OneWay}" Foreground="#FF4B5563" Margin="0,3,0,0" TextWrapping="Wrap" />

            <Border Background="#FFF4F8FF" BorderBrush="#FFD6E7FF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Comando que se ejecutará (fijado en código; no es editable)" FontWeight="SemiBold" Foreground="#FF2563A8" />
                    <TextBlock Text="{Binding CommandDisplay, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding RiskSummary, Mode=OneWay}" Foreground="#FF4B5563" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Preflight" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6" />
            <ItemsControl ItemsSource="{Binding Checks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Symbol, Mode=OneWay}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail, Mode=OneWay}" Foreground="#FF4B5563" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF6B4A00" TextWrapping="Wrap" Margin="0,8,0,0" />

            <CheckBox Content="He leído el comando, el riesgo y el preflight; apruebo esta ejecución concreta"
                      Checked="Approval_OnChecked" Unchecked="Approval_OnUnchecked"
                      IsEnabled="{Binding PlanAvailable, Mode=OneWay}"
                      Margin="0,16,0,0" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Ejecutar reparación" Click="Execute_OnClick"
                        Style="{StaticResource WsgPrimaryButtonStyle}"
                        IsEnabled="{Binding CanExecute, Mode=OneWay}" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="Cerrar" Click="Close_OnClick" IsEnabled="{Binding CanClose, Mode=OneWay}" />
            </Grid>

            <TextBlock Text="Progreso" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,6" />
            <ItemsControl ItemsSource="{Binding Messages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text, Mode=OneWay}" Foreground="#FF4B5563" TextWrapping="Wrap" Margin="0,2,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding OutcomeText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding GuidanceText, Mode=OneWay}" Foreground="#FF2563A8" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
