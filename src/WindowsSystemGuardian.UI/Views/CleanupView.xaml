<UserControl x:Class="WindowsSystemGuardian.UI.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,26,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Liberar espacio" Style="{StaticResource WsgSectionTitleStyle}" />
            <TextBlock Text="Análisis seguro de espacio recuperable. La versión actual solo observa y clasifica; no elimina archivos." Style="{StaticResource WsgMutedTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource WsgCardStyle}" Margin="0,20,0,16" BorderBrush="#FFBFD8FC" Background="#FFF5F9FF">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="{StaticResource WsgBlueSoftBrush}" CornerRadius="21" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgBlueBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="Análisis seguro" FontWeight="SemiBold" FontSize="15" Foreground="#FF172033" />
                    <TextBlock Text="Allowlist explícita · antigüedad mínima · reparse points bloqueados · archivos en uso omitidos." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource WsgMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Analizar limpieza segura" Click="AnalyzeCleanup_OnClick" Style="{StaticResource WsgPrimaryButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource WsgCardStyle}">
                <StackPanel>
                    <TextBlock Text="RECUPERABLE ESTIMADO" Style="{StaticResource WsgMutedTextStyle}" />
                    <TextBlock Text="{Binding RecoverableSpace, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="#FF111827" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource WsgCardStyle}">
                <StackPanel>
                    <TextBlock Text="CANDIDATOS SEGUROS" Style="{StaticResource WsgMutedTextStyle}" />
                    <TextBlock Text="{Binding CleanupFiles, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="#FF111827" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource WsgCardStyle}">
                <StackPanel>
                    <TextBlock Text="ARCHIVOS BLOQUEADOS" Style="{StaticResource WsgMutedTextStyle}" />
                    <TextBlock Text="{Binding CleanupLocked, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="#FF111827" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource WsgCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding CleanupSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="16,14" Foreground="#FF374151" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding CleanupCandidates, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category, Mode=OneWay}" Width="125" />
                        <DataGridTextColumn Header="Archivo" Binding="{Binding Path, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Tamaño" Binding="{Binding Size, Mode=OneWay}" Width="90" />
                        <DataGridTextColumn Header="Edad" Binding="{Binding Age, Mode=OneWay}" Width="80" />
                        <DataGridTextColumn Header="Riesgo" Binding="{Binding Risk, Mode=OneWay}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
