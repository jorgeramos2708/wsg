<UserControl x:Class="WindowsSystemGuardian.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,34">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Resumen del sistema" Style="{StaticResource WsgSectionTitleStyle}" />
                    <TextBlock Text="Vista general del estado, rendimiento y evidencia observada en Windows." Style="{StaticResource WsgMutedTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Actualizar" Click="Refresh_OnClick" VerticalAlignment="Center" Style="{StaticResource WsgPrimaryButtonStyle}" />
            </Grid>

            <!-- Resumen por severidad -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource WsgCardStyle}" BorderBrush="#FFB8E6C6" BorderThickness="2,1,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource WsgGoodSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgGoodBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Buen estado" Foreground="{StaticResource WsgGoodBrush}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding Observability.HealthyAreaCount, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" Foreground="#FF111827" />
                            <TextBlock Text="Áreas sin hallazgos activos" Style="{StaticResource WsgMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WsgCardStyle}" BorderBrush="#FFF5D48A" BorderThickness="2,1,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource WsgWarnSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgWarnBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Advertencia" Foreground="{StaticResource WsgWarnBrush}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding Observability.WarningCount, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" Foreground="#FF111827" />
                            <TextBlock Text="Hallazgos que requieren revisión" Style="{StaticResource WsgMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource WsgCardStyle}" BorderBrush="#FFF4B8B8" BorderThickness="2,1,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource WsgCriticalSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgCriticalBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Crítico" Foreground="{StaticResource WsgCriticalBrush}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding Observability.CriticalCount, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" Foreground="#FF111827" />
                            <TextBlock Text="Hallazgos de alta prioridad" Style="{StaticResource WsgMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource WsgCardStyle}" BorderBrush="#FFB8E6C6" BorderThickness="2,1,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource WsgGoodSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE83D;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgGoodBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Modo protegido WSG" Foreground="{StaticResource WsgGoodBrush}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding System.ProtectionValue, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" Foreground="#FF111827" />
                            <TextBlock Text="Política WSG aplicada" Style="{StaticResource WsgMutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Salud / análisis / observabilidad -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.12*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource WsgCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource WsgBlueSoftBrush}">
                                <TextBlock Text="&#xE95E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgBlueBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Salud del sistema" Style="{StaticResource WsgCardTitleStyle}" />
                                <TextBlock Text="Métricas de bajo impacto" Style="{StaticResource WsgMutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Foreground="#FF25324A" FontWeight="SemiBold" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Observability.CpuPercent, Mode=OneWay}" Height="7" Margin="8,5" />
                            <TextBlock Grid.Column="2" Text="{Binding Observability.CpuPercentText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#FF25324A" />
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Memoria" Foreground="#FF25324A" FontWeight="SemiBold" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Observability.MemoryPercent, Mode=OneWay}" Height="7" Margin="8,5" />
                            <TextBlock Grid.Column="2" Text="{Binding Observability.MemoryPercentText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#FF25324A" />
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Almacenamiento" Foreground="#FF25324A" FontWeight="SemiBold" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding System.StorageScore, Mode=OneWay}" Height="7" Margin="8,5" />
                            <TextBlock Grid.Column="2" Text="{Binding System.StorageScoreText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#FF25324A" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Tiempo activo" Foreground="#FF25324A" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Observability.UptimeText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource WsgGoodBrush}" />
                        </Grid>
                        <Button Content="Ver estado completo" Tag="observability" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" Margin="0,15,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WsgCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource WsgBlueSoftBrush}">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgBlueBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Análisis rápido" Style="{StaticResource WsgCardTitleStyle}" />
                                <TextBlock Text="Observación → evidencia → hallazgos" Style="{StaticResource WsgMutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Módulos ejecutados" Foreground="#FF25324A" />
                            <TextBlock Grid.Column="1" Text="{Binding Observability.SuccessfulCollectors, Mode=OneWay}" Foreground="{StaticResource WsgGoodBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Evidencias relevantes" Foreground="#FF25324A" />
                            <TextBlock Grid.Column="1" Text="{Binding Observability.EvidenceCount, Mode=OneWay}" Foreground="{StaticResource WsgBlueBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Eventos relevantes" Foreground="#FF25324A" />
                            <TextBlock Grid.Column="1" Text="{Binding Observability.RelevantEvents, Mode=OneWay}" Foreground="{StaticResource WsgWarnBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Servicios automáticos detenidos" Foreground="#FF25324A" />
                            <TextBlock Grid.Column="1" Text="{Binding Observability.AutomaticStoppedServices, Mode=OneWay}" Foreground="#FF25324A" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Incidentes correlacionados" Foreground="#FF25324A" />
                            <TextBlock Grid.Column="1" Text="{Binding Observability.IncidentCount, Mode=OneWay}" Foreground="{StaticResource WsgWarnBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding Observability.StatusText, Mode=OneWay}" Style="{StaticResource WsgMutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,10" />
                        <Button Content="Ejecutar análisis rápido" Click="Refresh_OnClick" Style="{StaticResource WsgPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource WsgCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource WsgGoodSoftBrush}">
                                <TextBlock Text="&#xE83D;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgGoodBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Observabilidad activa" Style="{StaticResource WsgCardTitleStyle}" />
                                <TextBlock Text="Sin reparación automática" Style="{StaticResource WsgMutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="✓ Event Log / Reliability" Foreground="#FF176B39" Margin="0,5" />
                        <TextBlock Text="✓ CPU, RAM, commit y procesos" Foreground="#FF176B39" Margin="0,5" />
                        <TextBlock Text="✓ Saturación de disco y red" Foreground="#FF176B39" Margin="0,5" />
                        <TextBlock Text="✓ Capacidad e histórico" Foreground="#FF176B39" Margin="0,5" />
                        <TextBlock Text="✓ Salud conservadora de servicios" Foreground="#FF176B39" Margin="0,5" />
                        <TextBlock Text="✓ Incidentes y causa probable" Foreground="#FF176B39" Margin="0,5" />
                        <TextBlock Text="✓ Persistencia local con retención" Foreground="#FF176B39" Margin="0,5,0,12" />
                        <TextBlock Text="Política activa" Style="{StaticResource WsgMutedTextStyle}" />
                        <TextBlock Text="{Binding System.Policy, Mode=OneWay}" Foreground="{StaticResource WsgGoodBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actividad / acciones -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource WsgCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hallazgos recientes" Style="{StaticResource WsgCardTitleStyle}" />
                                <TextBlock Text="Lo detectado por WSG; un hallazgo no autoriza una reparación." Style="{StaticResource WsgMutedTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ver estado" Tag="observability" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" Padding="10,6" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Observability.Findings, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFE5EAF1" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding SeverityColor, Mode=OneWay}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title, Mode=OneWay}" Foreground="#FF172033" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Explanation, Mode=OneWay}" Style="{StaticResource WsgMutedTextStyle}" TextWrapping="Wrap" Margin="0,2,8,0" MaxHeight="34" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Time, Mode=OneWay}" Style="{StaticResource WsgMutedTextStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Sin hallazgos = no se detectaron anomalías con las reglas implementadas; no significa ausencia absoluta de problemas."
                                   Style="{StaticResource WsgMutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WsgCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Acciones rápidas" Style="{StaticResource WsgCardTitleStyle}" />
                        <TextBlock Text="Acceso únicamente a módulos disponibles y seguros" Style="{StaticResource WsgMutedTextStyle}" Margin="0,2,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Grid.Column="0" Content="Estado del sistema" Tag="observability" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" />
                            <Button Grid.Column="2" Content="Almacenamiento" Tag="storage" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" />
                            <Button Grid.Row="2" Grid.Column="0" Content="Liberar espacio" Tag="cleanup" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Diagnóstico" Tag="diagnostics" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" />
                            <Button Grid.Row="4" Grid.Column="0" Content="Incidentes" Tag="incidents" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" />
                            <Button Grid.Row="4" Grid.Column="2" Content="Historial" Tag="history" Click="Navigate_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
