<UserControl x:Class="WindowsSystemGuardian.UI.Views.IntegrityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,26,30,34">
            <TextBlock Text="Integridad de Windows" Style="{StaticResource WsgSectionTitleStyle}" />
            <TextBlock Text="Sistema de archivos, almacén de componentes, archivos protegidos, Windows Update, WinRE y preparación VSS. Esta fase solo diagnostica; no ejecuta reparaciones." Style="{StaticResource WsgMutedTextStyle}" Margin="0,4,0,20" TextWrapping="Wrap" />

            <Border Style="{StaticResource WsgCardStyle}" BorderBrush="#FFBFD8FC" Background="#FFF5F9FF" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource WsgBlueSoftBrush}" CornerRadius="21">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WsgBlueBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Comprobación estándar" Style="{StaticResource WsgCardTitleStyle}" />
                        <TextBlock Text="Estado/dirty bit de volúmenes · DISM CheckHealth · Windows Update Agent · WinRE · escritores VSS" Style="{StaticResource WsgMutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="#FF374151" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Comprobar ahora" Click="RefreshQuick_OnClick" Style="{StaticResource WsgPrimaryButtonStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource WsgCardStyle}"><StackPanel><TextBlock Text="MÓDULOS EJECUTADOS" Style="{StaticResource WsgMutedTextStyle}"/><TextBlock Text="{Binding ModuleCount, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource WsgCardStyle}" BorderBrush="#FFF5D48A"><StackPanel><TextBlock Text="ADVERTENCIAS" Style="{StaticResource WsgMutedTextStyle}"/><TextBlock Text="{Binding WarningCount, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource WsgWarnBrush}" Margin="0,5,0,0" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource WsgCardStyle}" BorderBrush="#FFF2B4B7"><StackPanel><TextBlock Text="CRÍTICOS" Style="{StaticResource WsgMutedTextStyle}"/><TextBlock Text="{Binding CriticalCount, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource WsgCriticalBrush}" Margin="0,5,0,0" /></StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource WsgCardStyle}" Padding="0" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="18,16,18,10">
                        <TextBlock Text="Estado de componentes" Style="{StaticResource WsgCardTitleStyle}" />
                        <TextBlock Text="Buen estado significa que esa comprobación terminó sin una condición conocida de Advertencia/Crítico; no equivale a certificar todo Windows." Style="{StaticResource WsgMutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Modules, Mode=OneWay}" Margin="18,0,18,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource WsgBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF172033" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding State, Mode=OneWay}" Foreground="{Binding StatusColor, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Cost, Mode=OneWay}" Foreground="#FF374151" /><TextBlock Text="{Binding LastRun, Mode=OneWay}" Style="{StaticResource WsgMutedTextStyle}" /></StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap" Foreground="#FF4B5563" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Style="{StaticResource WsgCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Diagnósticos profundos · ejecución manual" Style="{StaticResource WsgCardTitleStyle}" />
                    <TextBlock Text="Pueden tardar y consumir I/O/CPU. Se ejecutan únicamente al solicitarlos y usan variantes de verificación sin reparación." Style="{StaticResource WsgMutedTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="DISM /ScanHealth" Click="DismScan_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" Margin="0,0,10,8" />
                        <Button Content="SFC /verifyonly" Click="SfcVerify_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" Margin="0,0,10,8" />
                        <Button Content="CHKDSK /scan (NTFS)" Click="FileSystemScan_OnClick" Style="{StaticResource WsgQuickActionButtonStyle}" Margin="0,0,10,8" />
                    </WrapPanel>
                    <TextBlock Text="No incluidos en 0.4.1: DISM /RestoreHealth, SFC /scannow, CHKDSK /f, /r, /spotfix, cambios de WinRE/VSS o reinicios automáticos." Foreground="#FF9A6700" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WsgCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Hallazgos de integridad y mantenimiento de Windows" Style="{StaticResource WsgCardTitleStyle}" Margin="18,16,18,10" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Findings, Mode=OneWay}" Margin="18,0,18,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource WsgBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF172033" />
                                        <TextBlock Text="{Binding Explanation, Mode=OneWay}" TextWrapping="Wrap" Foreground="#FF4B5563" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Recommendation, Mode=OneWay}" TextWrapping="Wrap" Foreground="#FF1267E8" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
