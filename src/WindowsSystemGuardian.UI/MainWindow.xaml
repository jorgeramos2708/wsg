<Window x:Class="WindowsSystemGuardian.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Windows System Guardian"
        Width="1200" Height="720"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource WsgPageBrush}" MinWidth="850">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource WsgSidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="20,24,16,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="58" Height="64" VerticalAlignment="Center">
                        <Canvas Width="64" Height="72">
                            <Path Data="M32,3 L57,10 L57,32 C57,50 47,62 32,69 C17,62 7,50 7,32 L7,10 Z"
                                  Stroke="#FF12A8FF" StrokeThickness="4" Fill="#180C7BDC" StrokeLineJoin="Round" />
                            <Rectangle Canvas.Left="17" Canvas.Top="18" Width="13" Height="13" Fill="#FF16A7F5" />
                            <Rectangle Canvas.Left="34" Canvas.Top="18" Width="13" Height="13" Fill="#FF1684E8" />
                            <Rectangle Canvas.Left="17" Canvas.Top="35" Width="13" Height="13" Fill="#FF1684E8" />
                            <Rectangle Canvas.Left="34" Canvas.Top="35" Width="13" Height="13" Fill="#FF1267D8" />
                            <Polyline Points="10,52 21,52 25,47 29,59 35,39 40,52 53,52"
                                      Stroke="#FF20D3F5" StrokeThickness="3" Fill="Transparent" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Windows" Foreground="White" FontWeight="Bold" FontSize="20" />
                        <TextBlock Text="System Guardian" Foreground="White" FontWeight="Bold" FontSize="20" Margin="0,-2,0,0" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="NavigationList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="NavigationList_OnSelectionChanged"
                         SelectedIndex="0"
                         ItemContainerStyle="{StaticResource WsgNavigationItemStyle}">
                    <ListBoxItem Tag="dashboard">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Inicio" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="observability">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Estado del sistema" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="incidents">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Incidentes" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="integrity">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Integridad de Windows" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="storage">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Almacenamiento" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="cleanup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Liberar espacio" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="diagnostics">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Diagnóstico" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="history">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="18" Width="32" /><TextBlock Text="Historial" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16,12,16,20">
                    <Border Background="#26159A55" BorderBrush="#4065D48C" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#2534D058" CornerRadius="17" VerticalAlignment="Top">
                                <TextBlock Text="&#xE83D;" FontFamily="Segoe Fluent Icons" Foreground="#FF62D986" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Modo protegido WSG" Foreground="#FF66DD86" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Política conservadora activa" Foreground="#FFD7E2F1" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Foreground="#FFAEC0D7" FontSize="10">
                        <Run Text="Última actualización: " /><Run Text="{Binding LastUpdated, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding VersionText, Mode=OneWay}" Foreground="#FF7F95B2" FontSize="10" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" />
        </Grid>
    </ScrollViewer>
</Window>
